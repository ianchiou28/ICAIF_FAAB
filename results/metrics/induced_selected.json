{
  "model": "deepseek-chat",
  "temperature": 0,
  "seeds": [
    101,
    202,
    303
  ],
  "selection_policy": "development root macro-F1, then clean retention, then joint agent-step",
  "selected_seed": 101,
  "selected_rule_set": {
    "version": "faab-rule-dsl-1.0",
    "rules": [
      {
        "rule_id": "R01",
        "priority": 10,
        "fault_type": "quote_mismatch",
        "responsible_agent": "evidence_agent",
        "decisive_step": 1,
        "description": "The evidence quote does not contain the raw value number",
        "condition": {
          "op": "any",
          "args": [
            {
              "op": "number_not_in_quote"
            },
            {
              "op": "number_in_other_span"
            }
          ]
        }
      },
      {
        "rule_id": "R02",
        "priority": 20,
        "fault_type": "role_violation",
        "responsible_agent": "evidence_agent",
        "decisive_step": 1,
        "description": "Evidence agent provided a recommendation when it should not",
        "condition": {
          "op": "not_empty",
          "value": {
            "path": "evidence.recommendation"
          }
        }
      },
      {
        "rule_id": "R03",
        "priority": 30,
        "fault_type": "future_leakage",
        "responsible_agent": "expectation_agent",
        "decisive_step": 2,
        "description": "Expectation visible_at is after decision time",
        "condition": {
          "op": "gt_time",
          "left": {
            "path": "expectation.visible_at"
          },
          "right": {
            "path": "decision.decision_time"
          }
        }
      },
      {
        "rule_id": "R04",
        "priority": 40,
        "fault_type": "definition_conflict",
        "responsible_agent": "expectation_agent",
        "decisive_step": 2,
        "description": "Expectation definition does not match evidence definition",
        "condition": {
          "op": "ne",
          "left": {
            "path": "expectation.definition"
          },
          "right": {
            "path": "evidence.definition"
          }
        }
      },
      {
        "rule_id": "R05",
        "priority": 50,
        "fault_type": "basis_conflict",
        "responsible_agent": "expectation_agent",
        "decisive_step": 2,
        "description": "Expectation basis does not match evidence basis",
        "condition": {
          "op": "ne",
          "left": {
            "path": "expectation.basis"
          },
          "right": {
            "path": "evidence.basis"
          }
        }
      },
      {
        "rule_id": "R06",
        "priority": 60,
        "fault_type": "wrong_window",
        "responsible_agent": "settlement_agent",
        "decisive_step": 5,
        "description": "Settlement horizon_td does not match source control_horizon_td",
        "condition": {
          "op": "ne",
          "left": {
            "path": "settlement.horizon_td"
          },
          "right": {
            "path": "source.control_horizon_td"
          }
        }
      },
      {
        "rule_id": "R07",
        "priority": 70,
        "fault_type": "missing_handoff",
        "responsible_agent": "decision_agent",
        "decisive_step": 4,
        "description": "Consistency hash is not in decision qualification_refs",
        "condition": {
          "op": "not_list_contains",
          "container": {
            "path": "decision.qualification_refs"
          },
          "value": {
            "path": "consistency.hash"
          }
        }
      },
      {
        "rule_id": "R08",
        "priority": 80,
        "fault_type": "unit_scaling",
        "responsible_agent": "evidence_agent",
        "decisive_step": 1,
        "description": "Evidence unit_multiplier is not 1.0",
        "condition": {
          "op": "ne",
          "left": {
            "path": "evidence.unit_multiplier"
          },
          "right": {
            "const": 1.0
          }
        }
      },
      {
        "rule_id": "R09",
        "priority": 90,
        "fault_type": "entity_confusion",
        "responsible_agent": "evidence_agent",
        "decisive_step": 1,
        "description": "Evidence entity does not match source ticker",
        "condition": {
          "op": "ne",
          "left": {
            "path": "evidence.entity"
          },
          "right": {
            "path": "source.ticker"
          }
        }
      },
      {
        "rule_id": "R10",
        "priority": 100,
        "fault_type": "fabricated_value",
        "responsible_agent": "evidence_agent",
        "decisive_step": 1,
        "description": "Evidence raw_value does not appear in the quote",
        "condition": {
          "op": "number_not_in_quote"
        }
      },
      {
        "rule_id": "R11",
        "priority": 110,
        "fault_type": "period_mismatch",
        "responsible_agent": "expectation_agent",
        "decisive_step": 2,
        "description": "Expectation period does not match evidence period",
        "condition": {
          "op": "ne",
          "left": {
            "path": "expectation.period"
          },
          "right": {
            "path": "evidence.period"
          }
        }
      },
      {
        "rule_id": "R12",
        "priority": 120,
        "fault_type": "stale_expectation",
        "responsible_agent": "expectation_agent",
        "decisive_step": 2,
        "description": "Expectation vintage is not the latest eligible vintage",
        "condition": {
          "op": "ne",
          "left": {
            "path": "expectation.vintage"
          },
          "right": {
            "path": "expectation.latest_eligible_vintage"
          }
        }
      },
      {
        "rule_id": "R13",
        "priority": 130,
        "fault_type": "silent_overwrite",
        "responsible_agent": "decision_agent",
        "decisive_step": 4,
        "description": "Decision value_used does not match consistency normalized_value",
        "condition": {
          "op": "numeric_not_close",
          "left": {
            "path": "decision.value_used"
          },
          "right": {
            "path": "consistency.normalized_value"
          }
        }
      },
      {
        "rule_id": "R14",
        "priority": 140,
        "fault_type": "wrong_security",
        "responsible_agent": "settlement_agent",
        "decisive_step": 5,
        "description": "Settlement ticker does not match source ticker",
        "condition": {
          "op": "ne",
          "left": {
            "path": "settlement.ticker"
          },
          "right": {
            "path": "source.ticker"
          }
        }
      }
    ]
  },
